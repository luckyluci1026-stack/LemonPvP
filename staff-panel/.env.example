# Copy this file to .env.local and fill in the values.
# .env.local is never committed to git.

# ── Authentication ───────────────────────────────────────────────
# Generate a strong random secret:  openssl rand -base64 48
JWT_SECRET=change-me-replace-with-64-random-chars

# ── Node environment ─────────────────────────────────────────────
NODE_ENV=production
