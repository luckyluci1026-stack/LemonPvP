# ---------------------------------------------------------------------------
# LearnDeveloping — Konfiguration zum LOKALEN Testen
#
#     cp .env.local.example .env
#     npm run dev
#
# Die Produktionsfassung steht in .env.example. Bitte nicht mischen: Vier
# Werte daraus sorgen lokal für Fehler, die schwer zu finden sind, weil nichts
# davon eine Fehlermeldung erzeugt. Sie sind unten jeweils erklärt.
# ---------------------------------------------------------------------------

# ---- (1) Der wichtigste Unterschied überhaupt -------------------------------
# Mit NODE_ENV=production bekommt das Sitzungs-Cookie die Markierung "secure",
# und die gilt nur über HTTPS. Über http://localhost wirft der Browser das
# Cookie dann still weg: Die Anmeldung scheint zu klappen, aber bei der
# nächsten Seite bist du wieder abgemeldet — ohne jede Meldung.
NODE_ENV=development

PORT=3000
HOST=127.0.0.1

# ---- (2) Muss auf die Adresse zeigen, unter der du die Seite aufrufst -------
# Steht hier die Live-Domain, verweisen Links in E-Mails ins Leere.
PUBLIC_URL=http://localhost:3000

# ---- (3) Lokal steht kein Proxy davor --------------------------------------
# Mit TRUST_PROXY=true glaubt der Server dem Header X-Forwarded-For. Den kann
# lokal jeder frei setzen — damit ließe sich die Anfragenbegrenzung umgehen.
TRUST_PROXY=false

SERVE_FRONTEND=true
FRONTEND_DIR=..

# ---- (4) Keine Datenbank installieren --------------------------------------
# SQLite steckt in Node ab Version 20 mit drin. Die Datei wird beim ersten
# `npm run dev` selbst angelegt; zum Zurücksetzen einfach löschen.
DATABASE_URL=sqlite:./data/local.db

# Lokal genügt irgendein Wert. Für den Livebetrieb: openssl rand -base64 48
SESSION_SECRET=lokal-nur-zum-testen-nicht-fuer-echt
SESSION_TTL_DAYS=30

# E-Mails gehen ins Terminal statt raus. Den Bestätigungscode findest du
# in der Serverausgabe.
SMTP_ENABLED=false

# Leer lassen: Ohne Secret wird die Botprüfung übersprungen. Mit einem Secret
# aus dem Cloudflare-Dashboard scheitert die Registrierung lokal.
TURNSTILE_SECRET=

# ============================== KI ==========================================
# Alles hier ist freiwillig. Ohne Schlüssel läuft die Plattform vollständig —
# die Aufgaben werden dann rein lokal im Browser bewertet.
#
# Bevor du den Server startest:
#     npm run ai:models     zeigt, welche Modelle dein Google-Schlüssel kennt
#     npm run ai:test       spielt eine echte Prüfung durch
# Beides braucht weder Server noch Datenbank.

AI_PROVIDER=gemini

# Schlüssel von https://aistudio.google.com/app/apikey — beginnt mit "AIza".
# Mehrere durch Komma trennen; sie werden reihum genutzt.
GEMINI_API_KEYS=

# Die genaue Schreibweise prüfst du mit `npm run ai:models`.
GEMINI_MODEL=gemma-4-31b-it

# ---- Rollen ----------------------------------------------------------------
# Zum Ausprobieren genügt eine einzige: Der Assistent in der IDE und die
# Prüfung laufen dann beide über Google. Wer mehr will, siehe .env.example.
AI_ASSIST_PROVIDER=gemini
AI_ASSIST_MODEL=gemma-4-31b-it

# Profi-Agent in der IDE (freiwillig). Schlüssel: https://console.groq.com
# Ohne Schlüssel erscheint der Umschalter in der Oberfläche gar nicht erst.
GROQ_API_KEYS=
AI_PRO_PROVIDER=groq

# ---- Antwortprüfung --------------------------------------------------------
AI_VERIFY_ENABLED=true
AI_VERIFY_PRIMARY=gemini
# Ersatz, wenn das Tageslimit erreicht ist. Läuft bei dir Ollama, ist `ollama`
# hier die beste Wahl — sonst `gemini` stehen lassen.
AI_VERIFY_FALLBACK=gemini

# Beim Ausprobieren stört ein Tageslimit nur — im Livebetrieb sind die Werte
# aus .env.example die richtigen.
AI_VERIFY_PRIMARY_PER_DAY=200
AI_VERIFY_MAX_PER_DAY=500
AI_VERIFY_GLOBAL_PER_DAY=2000

# Antwortet ein Modell langsam, lieber warten als abbrechen.
AI_TIMEOUT_MS=60000
AI_VERIFY_TIMEOUT_MS=30000

# ---- Sitzungsbremse für den Agenten ----------------------------------------
# Ein Limit pro Minute reicht nicht: Wer es einhält, kann trotzdem den ganzen
# Nachmittag Anfragen stellen. Gezählt wird deshalb in einem gleitenden
# Fenster — Anfragen und Text. Beim Ausprobieren darf es großzügiger sein.
AI_AGENT_WINDOW_HOURS=4
AI_AGENT_MAX_REQUESTS=20
AI_AGENT_MAX_TOKENS=8000

# ---- Eigener Rechner (freiwillig) ------------------------------------------
# Läuft `ollama serve`, kostet nichts und hat keine Limits.
# Den genauen Modellnamen zeigt `ollama list` — 1:1 übernehmen.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma-4-e4b

# ---- Der Disponent ---------------------------------------------------------
# Läuft ein Modell auf eigener Hardware, bekommt es die Anfrage ZUERST. Es
# beantwortet sie nicht selbst, sondern entscheidet, wer sie bearbeitet, und
# schreibt dazu einen kurzen Auftrag:
#
#   lokal    — es macht es selbst. Kurze Fragen, Tippfehler, ein bis drei
#              Sätze Erklärung. Kostet nichts und verlässt das Netz nicht.
#   standard — das Modell aus AI_ASSIST_PROVIDER (hier: Gemma 4 31B).
#   profi    — das Modell aus AI_PRO_PROVIDER (hier: Llama 3.3 70B).
#
# Ist Ollama nicht erreichbar, geht die Anfrage direkt an den eingestellten
# Anbieter. Der Agent fällt dadurch nie aus.
AI_DISPATCH_ENABLED=true
AI_DISPATCH_PROVIDER=ollama
# Leer lassen = OLLAMA_MODEL von oben. Für ein kleineres Modell als
# Disponent hier den Namen eintragen, z.B. gemma-4-e2b.
AI_DISPATCH_MODEL=
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_TOKENS=300
OLLAMA_CONTEXT=2048
OLLAMA_THREADS=0
# Beim Start vorladen — dauert einmalig, danach ist die erste Frage schnell.
AI_WARMUP=true

# ---- Speicher --------------------------------------------------------------
STORAGE_QUOTA_BYTES=1073741824
MAX_PROJECT_BYTES=5242880

# debug zeigt jede Anfrage — beim Fehlersuchen hilfreich, sonst laut.
LOG_LEVEL=info
