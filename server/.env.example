# ---------------------------------------------------------------------------
# LearnDeveloping — Server-Konfiguration
# Kopieren nach .env und Werte anpassen:  cp .env.example .env
# Die .env-Datei enthält Geheimnisse und gehört NICHT ins Git-Repository.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://learndeveloping.com

# Hinter Cloudflare/nginx: echte Client-IP aus den Proxy-Headern lesen
TRUST_PROXY=true

# Frontend (index.html + App.jsx) mit ausliefern
SERVE_FRONTEND=true
FRONTEND_DIR=..

# --------------------------------- Datenbank --------------------------------
DATABASE_URL=postgres://learndeveloping:PASSWORT@localhost:5432/learndeveloping
DB_POOL_MAX=10

# --------------------------------- Sitzungen --------------------------------
# Zwingend setzen! Erzeugen mit:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ----------------------------------- E-Mail ---------------------------------
# Ohne SMTP werden Verifizierungscodes nur ins Log geschrieben.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LearnDeveloping <noreply@learndeveloping.com>
SUPPORT_MAIL=support@learndeveloping.com

# -------------------------------- Cloudflare --------------------------------
# Secret-Key aus dem Turnstile-Dashboard. Der Site-Key gehört ins Frontend
# (index.html), nicht hierher. Ohne Secret wird die Prüfung übersprungen.
TURNSTILE_SECRET=

# ------------------------------------ KI ------------------------------------
# Anbieter: gemini | ollama | anthropic
AI_PROVIDER=gemini

# Mehrere Keys komma- oder zeilengetrennt. Sie werden reihum genutzt; bei
# Rate-Limit übernimmt automatisch der nächste.
GEMINI_API_KEYS=
ANTHROPIC_API_KEYS=

GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-4-6

# Eigener Server (kostenlos, ohne Limits)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Pausen in Sekunden, wenn ein Key limitiert bzw. erschöpft ist
AI_COOLDOWN_RATE_LIMIT=65
AI_COOLDOWN_QUOTA=600
AI_TIMEOUT_MS=60000

# Anfragen pro Nutzer und Minute
AI_PER_USER_PER_MINUTE=20

# --------------------------------- Speicher ---------------------------------
STORAGE_QUOTA_BYTES=2684354560
MAX_PROJECT_BYTES=5242880

LOG_LEVEL=info
