# ---------------------------------------------------------------------------
# LearnDeveloping — Server-Konfiguration
# Kopieren nach .env und Werte anpassen:  cp .env.example .env
# Die .env-Datei enthält Geheimnisse und gehört NICHT ins Git-Repository.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://learndeveloping.com

# Hinter Cloudflare/nginx: echte Client-IP aus den Proxy-Headern lesen
TRUST_PROXY=true

# Frontend (index.html + App.jsx) mit ausliefern
SERVE_FRONTEND=true
FRONTEND_DIR=..

# --------------------------------- Datenbank --------------------------------
DATABASE_URL=postgres://learndeveloping:PASSWORT@localhost:5432/learndeveloping
DB_POOL_MAX=10

# --------------------------------- Sitzungen --------------------------------
# Zwingend setzen! Erzeugen mit:  openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ----------------------------------- E-Mail ---------------------------------
# Ohne SMTP werden Verifizierungscodes nur ins Log geschrieben.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LearnDeveloping <noreply@learndeveloping.com>
SUPPORT_MAIL=support@learndeveloping.com

# -------------------------------- Cloudflare --------------------------------
# Secret-Key aus dem Turnstile-Dashboard. Der Site-Key gehört ins Frontend
# (index.html), nicht hierher. Ohne Secret wird die Prüfung übersprungen.
TURNSTILE_SECRET=

# ------------------------------------ KI ------------------------------------
# Anbieter: gemini | anthropic | openrouter | ollama
AI_PROVIDER=gemini

# Mehrere Keys komma- oder zeilengetrennt. Sie werden reihum genutzt; bei
# Rate-Limit übernimmt automatisch der nächste.
GEMINI_API_KEYS=
ANTHROPIC_API_KEYS=

# Gemma 4 läuft über dieselbe Google-Schnittstelle wie Gemini. Alternativen:
# gemini-2.0-flash (schneller, kostenpflichtig ab Kontingent), gemma-4-31b-it
# (kostenlos, 256k Kontext). Gültige IDs: ai.google.dev
GEMINI_MODEL=gemma-4-31b-it
ANTHROPIC_MODEL=claude-sonnet-4-6

# ------------------------------- OpenRouter ---------------------------------
# Ein Zugang für viele Modelle, Schnittstelle wie bei OpenAI. Interessant vor
# allem wegen der kostenlosen Modelle.
#
# WICHTIG, bevor du das einschaltest:
#  1. Die Modell-ID auf https://openrouter.ai/models nachschlagen und exakt so
#     eintragen. IDs aus Blogposts, Foren oder von einem Chatbot stimmen häufig
#     nicht — OpenRouter antwortet dann mit 404, und die Prüfung fällt still
#     auf die lokale Analyse zurück. `npm run ai:test` deckt genau das auf.
#  2. Die Datenschutz-Einstellung des Kontos prüfen. Für die kostenlosen
#     Modelle verlangt OpenRouter meist, dass Anfragen zum Training verwendet
#     werden dürfen. Hier gingen die Antworten von Lernenden mit — bei einem
#     Schuleinsatz ist das eine bewusste Entscheidung, keine Nebensache.
#  3. Die freien Kontingente sind eng: bei google/gemma-4-31b-it:free etwa
#     20 Anfragen pro Minute und 200 pro Tag — und zwar pro KONTO, nicht pro
#     Nutzer. Deshalb steht AI_VERIFY_GLOBAL_PER_DAY unten deutlich darunter.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Eigener Server (kostenlos, ohne Limits)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Pausen in Sekunden, wenn ein Key limitiert bzw. erschöpft ist
AI_COOLDOWN_RATE_LIMIT=65
AI_COOLDOWN_QUOTA=600
AI_TIMEOUT_MS=60000

# Anfragen pro Nutzer und Minute
AI_PER_USER_PER_MINUTE=20

# ------------------- Antwortprüfung offener Aufgaben ------------------------
# Bei "schreib den Code" oder "erkläre …" holt der Server eine Zweitmeinung
# ein. Ohne Keys passiert das nicht — dann bewertet allein die lokale Analyse
# im Browser, und die Lektionen laufen unverändert weiter.
#
# Kostenbremse in drei Stufen, damit die Monatsrechnung planbar bleibt:
#   bis AI_VERIFY_PRIMARY_PER_DAY  -> der Hauptanbieter (AI_VERIFY_PRIMARY)
#   danach bis AI_VERIFY_MAX_PER_DAY -> der Ersatz (AI_VERIFY_FALLBACK)
#   darüber                        -> nur noch die lokale Analyse
#
# Schnelltest der Einrichtung, ohne Server und ohne Datenbank:
#     npm run ai:test          (Haupt- und Ersatzanbieter)
#     npm run ai:test -- alle  (jeden konfigurierten)
AI_VERIFY_ENABLED=true
# Mögliche Werte: gemini | anthropic | openrouter | ollama
# Vorgabe: Googles eigene API als Hauptanbieter, OpenRouter als Ersatz.
AI_VERIFY_PRIMARY=gemini
AI_VERIFY_FALLBACK=openrouter
AI_VERIFY_PRIMARY_PER_DAY=60
AI_VERIFY_MAX_PER_DAY=150
# Über alle Nutzer zusammen. Bei einem freien Kontingent von 200 Anfragen am
# Tag hier darunter bleiben, sonst laufen alle ins Limit.
AI_VERIFY_GLOBAL_PER_DAY=180
AI_VERIFY_TIMEOUT_MS=12000

# --------------------------------- Speicher ---------------------------------
# Freies Kontingent je Konto (Standard: 1 GB)
STORAGE_QUOTA_BYTES=1073741824
MAX_PROJECT_BYTES=5242880

LOG_LEVEL=info

# ------------------- Ollama auf schwacher Hardware --------------------------
# Modell im Speicher halten, sonst kostet jeder Aufruf das erneute Laden
OLLAMA_KEEP_ALIVE=30m
# Kurze Antworten sparen am meisten Zeit (die Bewertungen sind 3-4 Sätze lang)
OLLAMA_MAX_TOKENS=300
OLLAMA_CONTEXT=2048
# 0 = Ollama wählt selbst; auf sehr schwachen Geräten z.B. 2 setzen
OLLAMA_THREADS=0
# Modell beim Serverstart vorladen
AI_WARMUP=true
