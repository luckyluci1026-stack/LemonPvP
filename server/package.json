{
  "name": "learndeveloping-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend für LearnDeveloping — Konten, Fortschritt, Projekte und KI-Proxy",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/migrate.js && node src/index.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test": "node --test test/integration.test.js test/reset.test.js test/password.test.js test/rotation.test.js",
    "start:local": "DATABASE_URL=sqlite:./data/local.db SESSION_SECRET=lokal-nur-zum-testen NODE_ENV=development node src/migrate.js && DATABASE_URL=sqlite:./data/local.db SESSION_SECRET=lokal-nur-zum-testen NODE_ENV=development node src/index.js",
    "seed:local": "DATABASE_URL=sqlite:./data/local.db SESSION_SECRET=lokal-nur-zum-testen node src/seed.js",
    "ai:test": "node tools/ai-check.js",
    "ai:models": "node tools/ai-models.js",
    "migrate:local": "DATABASE_URL=sqlite:./data/local.db node src/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0"
  }
}
