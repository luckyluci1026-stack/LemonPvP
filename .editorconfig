# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,svg,html}]
indent_size = 2

[*.sh]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Generated fork patches and Paper's files must stay byte-for-byte as generated.
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset

[{index.html,index.zip,gradlew,gradlew.bat}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
